# ════════════════════════════════════════════════════════════
#  PR Code Reviewer — Universal Config
#  Set PROVIDER and the matching block below. Ignore the rest.
# ════════════════════════════════════════════════════════════

# ─── GitHub ──────────────────────────────────────────────────
# Create at: https://github.com/settings/tokens
# Permissions: Pull requests (Read/Write), Contents (Read)
GITHUB_TOKEN=your_personal_access_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Server ──────────────────────────────────────────────────
PORT=3000

# ════════════════════════════════════════════════════════════
#  CHOOSE YOUR PROVIDER — set one of: ollama | openai | gemini
# ════════════════════════════════════════════════════════════
PROVIDER=ollama

# ─────────────────────────────────────────────────────────────
#  OLLAMA (local machine or VM)
#  Start with: OLLAMA_ORIGINS="*" ollama serve
#  Pull model: ollama pull codellama
# ─────────────────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=codellama
# LLM_API_KEY not needed for Ollama

# ─────────────────────────────────────────────────────────────
#  QWEN CODER on a VM via Ollama
#  SSH into VM, install Ollama, run: ollama pull qwen2.5-coder
#  Then expose port 11434 or use SSH tunnel:
#    ssh -L 11434:localhost:11434 user@your-vm-ip
# ─────────────────────────────────────────────────────────────
# PROVIDER=ollama
# LLM_BASE_URL=http://your-vm-ip:11434
# LLM_MODEL=qwen2.5-coder:7b

# ─────────────────────────────────────────────────────────────
#  QWEN CODER via vLLM / LM Studio (OpenAI-compatible API)
#  vLLM:      python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen2.5-Coder-7B-Instruct
#  LM Studio: Start server in app, default port 1234
# ─────────────────────────────────────────────────────────────
# PROVIDER=openai
# LLM_BASE_URL=http://your-vm-ip:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# LLM_API_KEY=none

# ─────────────────────────────────────────────────────────────
#  OPENAI (cloud)
#  Key at: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────
# PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
#  GROQ (fast cloud inference — supports Qwen, Llama, etc.)
#  Key at: https://console.groq.com/keys
# ─────────────────────────────────────────────────────────────
# PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen-qwq-32b
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
#  TOGETHER AI (cloud — supports Qwen Coder)
#  Key at: https://api.together.xyz/settings/api-keys
# ─────────────────────────────────────────────────────────────
# PROVIDER=openai
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-Turbo
# LLM_API_KEY=your_together_api_key

# ─────────────────────────────────────────────────────────────
#  GOOGLE GEMINI (cloud)
#  Key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────
# PROVIDER=gemini
# LLM_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-1.5-flash
